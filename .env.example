# =====================================================================
# MindClarity - Variables de Entorno (Plantilla de Configuración)
# Copia este archivo como ".env" y personaliza según tus necesidades:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Modo de Inteligencia Artificial (AI_PROVIDER)
#   - 'ollama': 100% Local y gratuito (No requiere API keys externas)
#   - 'auto'  : Nube híbrida con OpenAI (GPT-4o) y fallback a Google Gemini
# ---------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

# Parámetros para modo Cloud / Router de Nube
OPENAI_API_KEY=sk-...                     # Clave de OpenAI (proveedor principal de IA)
GEMINI_API_KEY=                           # Clave de Gemini (fallback automático si OpenAI falla)
MODEL_NAME=gpt-4o                         # Modelo principal de chat (OpenAI)
GEMINI_MODEL_NAME=gemini-3.6-flash        # Modelo de respaldo
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.7
MAX_TOKENS=1024

# ---------------------------------------------------------------------
# Proveedor de Voz (STT y TTS)
#   - TTS_PROVIDER='piper': Voz offline sintética de alta velocidad (Local)
#   - TTS_PROVIDER='auto' : ElevenLabs de ultra-baja latencia (o Piper si no hay clave)
# ---------------------------------------------------------------------
TTS_PROVIDER=piper
ELEVENLABS_API_KEY=                       # Clave de ElevenLabs (Opcional)
VOICE_ID=EXAVITQu4vr4xnSDxMaL             # ID de voz en ElevenLabs (ej. Bella)
ELEVENLABS_MODEL=eleven_multilingual_v2
PIPER_VOICE=es_ES-davefx-medium           # Modelo local de Piper TTS

# Configuración de Reconocimiento y Wake Word
WAKE_WORD=yu                              # Palabra de activación
VOICE_BACKEND=vosk                        # 'vosk' para detección continua ligera, 'whisper' clásico
VOSK_MODEL_PATH=.cache/vosk/vosk-model-small-es-0.42
# VOICE_INPUT_DEVICE=                    # Índice numérico opcional de dispositivo de entrada de audio
VOICE_INPUT_HOSTAPI=MME                   # API de audio en Windows
WAKE_WORD_MODEL_PATH=                     # Ruta a modelo ONNX de openWakeWord (opcional)
WHISPER_MODEL_SIZE=medium                 # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                        # cpu o cuda
WHISPER_COMPUTE_TYPE=int8                 # int8 | float16 | float32
LANGUAGE=auto                             # es | en | auto
VOICE_LANGUAGE=es
VOICE_ENERGY_THRESHOLD=0.002
VOICE_SILENCE_SECONDS=0.8
VOICE_START_TIMEOUT=6
VOICE_MAX_SECONDS=15
SAMPLE_RATE=16000
RECORD_SECONDS=8

# ---------------------------------------------------------------------
# Base de Datos y Memoria Semántica (Opcional - Supabase con pgvector)
# ---------------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=
MAX_CONTEXT_TOKENS=6000
SHORT_TERM_SIZE=20
MEMORY_SIMILARITY_THRESHOLD=0.75

# ---------------------------------------------------------------------
# Integraciones Adicionales (Opcionales)
# ---------------------------------------------------------------------
OPENWEATHER_API_KEY=                      # Si está vacío, se utiliza el servicio gratuito wttr.in
OBSIDIAN_VAULT_PATH=                      # Ruta a tu bóveda de Obsidian en Windows (ej. C:/Users/TuUsuario/MiBoveda)

# Spotify
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Redes y Notificaciones
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_BOT_TOKEN=
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=

# ---------------------------------------------------------------------
# Comportamiento y Seguridad
# ---------------------------------------------------------------------
ASSISTANT_NAME=YU
USER_NAME=Usuario
REQUIRE_CONFIRMATION_HIGH_RISK=true       # Solicitar confirmación para borrar archivos o comandos críticos
LOG_LEVEL=INFO
